# Copy to .env and fill in. Nothing here should be committed.

# AnyLog operator node. Leave as loopback when running on the deployment host.
ANYLOG_HOST=127.0.0.1
ANYLOG_REST_PORT=32149

# Gemma serving endpoint, OpenAI compatible.
# Pin the exact checkpoint revision in GEMMA_MODEL after a serving test.
GEMMA_BASE_URL=http://127.0.0.1:8001/v1
GEMMA_MODEL=
GEMMA_ADAPTER=

# Respan gateway and tracing.
RESPAN_BASE_URL=
RESPAN_API_KEY=

# Nango, for the Google Sheets review loop.
NANGO_BASE_URL=https://api.nango.dev
NANGO_SECRET_KEY=
NANGO_CONNECTION_ID=
REVIEW_SHEET_ID=

# Home Assistant. No default address. Reachable only from inside the
# building's own LAN, so set this on a host that sits there.
HA_URL=
HA_TOKEN_FILE=
